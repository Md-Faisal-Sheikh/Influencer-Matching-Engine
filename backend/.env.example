PORT=5000
NODE_ENV=development

# Optional free live-data integration.
# YouTube Data API v3 has a daily free quota; channels.list costs 1 unit.
YOUTUBE_API_KEY=

# Optional free database tier.
# Leave blank to use localDb.json for demos and local development.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional when deploying frontend and backend to different domains.
# Example: https://your-frontend.vercel.app
CORS_ORIGIN=
